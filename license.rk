#!/usr/bin/env -S renk script
---
[dependencies]
clap = { version = "4.6.8", features = ["derive"] }
jiff = "1.0.0"
serde = { version = "1.0.229", features = ["derive"] }
toml = "1.2.1"
ureq = { version = "3.5.2", features = ["json"] }
urlencoding = "2.1.3"
---

use clap::{Args, CommandFactory, FromArgMatches, Parser, Subcommand}
use serde::Deserialize
use std::path::PathBuf

type Error = Box[dyn std::error::Error + Send + Sync]

const APP_NAME: &str = "license-add"
const GITHUB_LICENSE_API: &str = "https://api.github.com/licenses"

/// Print a license text with the year and the author filled in
#[derive(Parser)]
#[command(name = "license.rk")]
struct Cli:
    #[command(subcommand)]
    command: Cmd

#[derive(Subcommand)]
enum Cmd:
    /// Print the license KEY; it is fetched from GitHub once, then read from the cache
    Add(AddArgs)

#[derive(Args)]
struct AddArgs:
    /// License key, such as mit (default: `default` in the config)
    #[arg(value_name = "KEY")]
    key: Option[String]
    /// Config file (default: ~/.config/license-add/config.toml)
    #[arg(long, value_name = "PATH")]
    config: Option[String]
    /// Author name
    #[arg(short, long, value_name = "NAME")]
    author: Option[String]
    /// Year, or auto for the current year (default: the current year)
    #[arg(short, long, value_name = "YEAR")]
    year: Option[String]
    /// GitHub token for the license API
    #[arg(short, long, value_name = "TOKEN")]
    token: Option[String]

/// Config values; a value in the `[license]` table wins over the same value at the top level.
#[derive(Deserialize, Default)]
struct Fields:
    default: Option[String]
    author: Option[String]
    year: Option[String]
    token: Option[String]

#[derive(Deserialize)]
struct Config:
    #[serde(flatten)]
    top: Fields
    license: Option[Fields]

#[derive(Deserialize)]
struct License:
    key: String
    body: String

fn home() -> PathBuf:
    std::env::var_os("HOME")
        .map(PathBuf::from)
        .unwrap_or_else(|| std::env::current_dir().unwrap_or_default())

fn xdg(var: &str, fallback: &str) -> PathBuf:
    std::env::var_os(var)
        .filter(|dir| !dir.is_empty())
        .map(PathBuf::from)
        .unwrap_or_else(|| home().join(fallback))

fn config_dir() -> PathBuf:
    xdg("XDG_CONFIG_HOME", ".config").join(APP_NAME)

fn cache_dir() -> PathBuf:
    xdg("XDG_CACHE_HOME", ".cache").join(APP_NAME)

fn cache_path(key: &str) -> PathBuf:
    cache_dir().join(format!("{urlencoding::encode(key)}.txt"))

fn expand_home(path: &str) -> PathBuf:
    match path.strip_prefix("~"):
        Some("") => home()
        Some(rest) if rest.starts_with('/') => home().join(&rest[1..])
        _ => PathBuf::from(path)

fn current_year() -> String:
    jiff::ZonedDateTime::now().year().to_string()

fn load_config(path: &std::path::Path) -> Result[Fields, Error]:
    let text = match std::fs::read_to_string(path):
        Ok(text) => text
        Err(err) if err.kind() == std::io::ErrorKind::NotFound => return Ok(Fields::default())
        Err(err) => return Err(err.into())
    let config: Config = toml::from_str(&text)
        .map_err(|err| format!("Invalid config file ({path.display()}): {err}"))?
    let nested = config.license.unwrap_or_default()
    let top = config.top
    Ok(Fields {
        default: nested.default.or(top.default),
        author: nested.author.or(top.author),
        year: nested.year.or(top.year),
        token: nested.token.or(top.token),
    })

fn cached_keys() -> Vec[String]:
    let mut keys = Vec::new()
    if let Ok(entries) = std::fs::read_dir(cache_dir()):
        for entry in entries.flatten():
            let name = entry.file_name().to_string_lossy().into_owned()
            if let Some(key) = name.strip_suffix(".txt"):
                if entry.file_type().is_ok_and(|kind| kind.is_file()):
                    keys.push(
                        urlencoding::decode(key)
                            .map_or_else(|_| key.to_string(), |key| key.into_owned()),
                    )
    keys.sort()
    keys.dedup()
    keys

fn fetch_license(key: &str, token: Option[&str]) -> Result[License, Error]:
    let mut request = ureq::get(format!(
        "{}/{}",
        GITHUB_LICENSE_API,
        urlencoding::encode(key)
    ))
    .header("User-Agent", "license-script")
    .header("Accept", "application/vnd.github.v3+json")
    if let Some(token) = token:
        request = request.header("Authorization", format!("token {token}"))
    let mut response = request
        .config()
        .http_status_as_error(false)
        .build()
        .call()?
    let status = response.status()
    if !status.is_success():
        let body = response.body_mut().read_to_string()?
        return Err(format!("Failed to fetch license \"{key}\": {status}\n{body}").into())
    Ok(response.body_mut().read_json[License]()?)

fn license(key: &str, token: Option[&str]) -> Result[License, Error]:
    match std::fs::read_to_string(cache_path(key)):
        Ok(body) =>:
            return Ok(License {
                key: key.to_string(),
                body,
            })
        Err(err) if err.kind() != std::io::ErrorKind::NotFound => return Err(err.into())
        Err(_) => ()
    let license = fetch_license(key, token).map_err(|err| {
        format!("License \"{key}\" is not cached and could not be fetched. {err}")
    })?
    std::fs::write(cache_path(&license.key), &license.body)?
    Ok(license)

/// `text` of the license `key` with its year and author placeholders replaced.
fn fill(text: &str, key: &str, year: &str, author: Option[&str]) -> String:
    let (year_mark, author_mark) = match key:
        "agpl-3.0" | "gpl-2.0" | "gpl-3.0" | "lgpl-2.1" =>:
            (Some("<year>"), Some("<name of author>"))
        "apache-2.0" => (Some("[yyyy]"), Some("[name of copyright owner]"))
        "bsd-2-clause" | "bsd-3-clause" | "bsd-4-clause" | "mit" | "isc" =>:
            (Some("[year]"), Some("[fullname]"))
        "wtfpl" => (None, Some("Sam Hocevar <sam@hocevar.net>"))
        _ => (None, None)
    let mut text = text.to_string()
    if let Some(mark) = year_mark:
        text = text.replace(mark, year)
    if key == "wtfpl":
        // The second 2004 is the copyright year; the first is the license version date.
        let second = text.match_indices("2004").nth(1).map(|(at, _)| at)
        if let Some(at) = second:
            text.replace_range(at..at + 4, year)
    if let (Some(mark), Some(author)) = (author_mark, author):
        text = text.replace(mark, author)
    text

fn run() -> Result[(), Error]:
    std::fs::create_dir_all(config_dir())?
    std::fs::create_dir_all(cache_dir())?
    let keys = cached_keys()
    let mut command = Cli::command()
    if !keys.is_empty():
        let help = format!("License key (cached: {keys.join(", ")})")
        command = command.mut_subcommand("add", |add| add.mut_arg("key", |arg| arg.help(help)))
    let matches = command.get_matches()
    let Cmd::Add(args) = Cli::from_arg_matches(&matches)
        .unwrap_or_else(|err| err.exit())
        .command
    let config_path = match args.config.as_deref().map(str::trim):
        Some(path) if !path.is_empty() => expand_home(path)
        _ => config_dir().join("config.toml")
    let config = load_config(&config_path)?
    let key = args.key.or(config.default).filter(|key| !key.is_empty()).ok_or("License key is required. Provide one as an argument or config default in ~/.config/license-add/config.toml")?
    let year = match args.year.or(config.year).as_deref().map(str::trim):
        None | Some("" | "auto" | "current") => current_year()
        Some(year) => year.to_string()
    let author = args
        .author
        .or(config.author)
        .filter(|author| !author.is_empty())
    let token = args
        .token
        .or(config.token)
        .filter(|token| !token.is_empty())
    let license = license(&key, token.as_deref())?
    println!("{fill(&license.body, &license.key, &year, author.as_deref())}")
    Ok(())

fn main():
    if let Err(err) = run():
        eprintln!("{err}")
        std::process::exit(1)
