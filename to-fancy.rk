#!/usr/bin/env -S renk script
---
[dependencies]
clap = { version = "4", features = ["derive"] }
regex = "1"
---

use clap::Parser

#[derive(Parser)]
#[command(name = "to_fancy", bin_name = "to_fancy", version = "0.1.2", about = "Convert straight quotes to fancy quotes and merge paragraphs.")]
struct Cli:
    /// Edit file in-place (prevents data loss from shell redirection)
    #[arg(short, long)]
    inplace: bool
    file: std.path.PathBuf

fn to_fancy(text: &str) -> String:
    let curly = regex::Regex.new(r"[“”]").unwrap()
    let opening = regex::Regex.new(r#"(^|[\s(\[{])""#).unwrap()
    let blank_lines = regex::Regex.new(r"(\r\n|\n|\r){2,}").unwrap()
    let text = curly.replace_all(text, "\"")
    let text = opening.replace_all(&text, "${1}“")
    let text = text.replace('"', "”")
    blank_lines.replace_all(&text, "\n").into_owned()

fn main():
    let cli = Cli.parse()
    let content = match std.fs.read_to_string(&cli.file):
        Ok(content) => content
        Err(err) =>:
            eprintln!("error: {err}")
            std.process.exit(1)
    let result = to_fancy(&content)
    if cli.inplace:
        std.fs.write(&cli.file, result).unwrap()
    else:
        println!("{result}")
